{
  "name": "astrelis",
  "productName": "ASTRELIS",
  "version": "2.18.7",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Professional futuristic audio workstation and music visualizer for Windows",
  "author": "ASTRELIS",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k --success first \"vite --port 41739 --strictPort\" \"pnpm dev:electron\"",
    "dev:electron": "wait-on tcp:41739 && pnpm build:window && tsc -p electron/tsconfig.json && cross-env VITE_DEV_SERVER_URL=http://localhost:41739 electron .",
    "build:window": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-window.ps1",
    "build": "pnpm build:window && tsc -b && vite build && tsc -p electron/tsconfig.json",
    "lint": "eslint src electron tests scripts build",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test:renderer": "node --test tests/renderer/*.test.cjs",
    "test:electron": "tsc -p electron/tsconfig.json && node --test tests/electron/*.test.cjs",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "test:native:device": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1 -RequireDevice",
    "test": "pnpm test:renderer && pnpm test:electron && pnpm test:native",
    "verify": "pnpm lint && pnpm build && pnpm build:native && pnpm test",
    "preview": "vite preview",
    "start": "electron .",
    "dist:win": "pnpm verify && electron-builder --win nsis",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "tune:visualizer": "node scripts/visualizer-tuning.cjs"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.36.2",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.9.0",
    "opencc-js": "1.4.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.46.4",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.auralis.player",
    "productName": "ASTRELIS",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "auralis-version.json",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "wav",
          "flac",
          "aac",
          "ogg",
          "m4a",
          "ape",
          "dsf",
          "aiff",
          "aif",
          "opus",
          "wma",
          "dts",
          "ac3",
          "eac3"
        ],
        "name": "ASTRELIS Audio",
        "description": "Audio file",
        "role": "Viewer"
      }
    ],
    "extraResources": [
      {
        "from": "video-engine",
        "to": "video-engine",
        "filter": [
          "astrelis-controls.lua",
          "astrelis-input.lua",
          "mpv.exe",
          "d3dcompiler_43.dll",
          "README.md",
          "LICENSE*",
          "runtime.json"
        ]
      },
      {
        "from": "native-window/build/Release/window_outline.node",
        "to": "native-window/window_outline.node"
      },
      {
        "from": "native-window/NODE-GYP-LICENSE",
        "to": "native-window/NODE-GYP-LICENSE"
      },
      {
        "from": "native-host/build/AuralisPluginHost_artefacts/Release/AuralisPluginHost.exe",
        "to": "native-host/AuralisPluginHost.exe"
      },
      {
        "from": "build/icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "ffmpeg/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "build/data-lifecycle.ps1",
        "to": "data-lifecycle.ps1"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE-STATUS.md",
        "to": "LICENSE-STATUS.md"
      },
      {
        "from": "build/localize-install.ps1",
        "to": "localize-install.ps1"
      },
      {
        "from": "node_modules/opencc-js",
        "to": "licenses/opencc-js",
        "filter": [
          "LICENSE",
          "LICENSES/Apache-2.0.txt",
          "THIRD_PARTY_LICENSES.md"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ASTRELIS-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ASTRELIS",
      "uninstallDisplayName": "ASTRELIS",
      "include": "build/installer.nsh",
      "allowElevation": false,
      "runAfterFinish": false
    },
    "afterPack": "./build/after-pack.cjs"
  }
}
